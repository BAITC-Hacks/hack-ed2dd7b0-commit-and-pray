# Backend (FastAPI)
# LLM используется только для объяснения уже посчитанного Score — числа он не
# придумывает. Без ключа приложение работает на детерминированном
# fallback-тексте, демо не ломается.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY_BACKUP=
LLM_BASE_URL_BACKUP=https://integrate.api.nvidia.com/v1
LLM_MODEL_BACKUP=meta/llama-3.1-8b-instruct

# Через запятую, без пробелов после запятой
CORS_ORIGINS=http://localhost:5173

# Frontend (Vite) — прокси на backend уже настроен в vite.config.ts,
# переменная нужна только для сборки без dev-прокси (напр. Docker)
VITE_API_BASE_URL=http://localhost:8000
